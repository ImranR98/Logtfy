{
    "ntfyConfig": {
        "configs": [
            {
                "id": "ntfy_official",
                "host": "https://ntfy.sh",
                "authHeader": null,
                "topicPrefix": "logtfy_"
            }
        ],
        "defaultConfig": "ntfy_official",
        "fallbackConfig": null
    },
    "modulesEnabledByDefault": false,
    "crashNotificationInitialBackoffSeconds": 60,
    "crashNotificationMaxBackoffSeconds": 3600,
    "moduleCustomization": [
        {
            "module": "ssh_logins",
            "enabled": false,
            "ntfyTopic": null,
            "ntfyConfig": null,
            "ntfyFallback": null,
            "loggerArg": "sshd",
            "parserArg": null
        },
        {
            "module": "mock_module",
            "defaultPriority": "4",
            "defaultTags": "computer,tada",
            "enabled": true
        },
        {
            "module": "traefik_geoblock_allowed_requests_k8s",
            "loggerArg": "production",
            "ntfyTopic": "logtfy",
            "enabled": false
        },
        {
            "module": "generic_logs",
            "moduleInstances": [
                {
                    "name": "traefik_errors",
                    "enabled": false,
                    "loggerArg": "traefik stderr2stdout",
                    "parserArg": "{\"regex\":\"error\",\"title\":\"Traefik error\",\"message\":\"A traefik log line matched:\"}"
                },
                {
                    "name": "app_k8s_errors",
                    "enabled": false,
                    "loggerArg": "k8s myapp production",
                    "parserArg": "{\"regex\":\"fatal\",\"title\":\"App fatal error\",\"message\":\"A log line from myapp matched:\"}"
                }
            ]
        }
    ]
}