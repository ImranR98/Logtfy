{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":configMigration"
  ],
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": true,
  "rangeStrategy": "replace",
  "separateMajorMinor": true,
  "automerge": false,
  "packageRules": [
    {
      "description": "Docker base image and CLI digest refreshes",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "groupName": "docker base images"
    },
    {
      "description": "Docker base image non-major version updates",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "pin"],
      "groupName": "docker base images (non-major)"
    },
    {
      "description": "GitHub Actions updates (non-major grouped)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "github actions"
    },
    {
      "description": "Auto-merge non-major updates only after the required test check and native auto-merge are enabled (squash is allowed on this repo)",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true,
      "platformAutomerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "ignoreTests": false
    },
    {
      "description": "Majors stay as separate PRs and are always manual: the gate cannot prove base-OS/runtime compatibility for a new major",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "platformAutomerge": false
    }
  ]
}
